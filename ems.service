[Unit]
Description=EMS Supervisord
After=network.target

[Service]
Type=simple
RuntimeDirectory=campus-ems
RuntimeDirectoryMode=0750
UMask=0007
ExecStartPre=/usr/bin/install -m 0640 /home/pi/ems/portal/supervisord.conf /run/campus-ems/portal.conf
KillMode=mixed
TimeoutStopSec=120
ExecStart=supervisord -c /home/pi/ems/supervisord.conf
ExecStartPost=/usr/bin/timeout 20 /bin/sh -c "until [ -S /run/campus-ems/supervisor.sock ]; do /usr/bin/sleep 0.2; done; /usr/bin/chgrp pi /run/campus-ems /run/campus-ems/supervisor.sock && /usr/bin/chmod 0660 /run/campus-ems/supervisor.sock"
Restart=always

[Install]
WantedBy=multi-user.target
