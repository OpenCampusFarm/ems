# WattTime
WT_USERNAME=
WT_PASSWORD=
WT_REGION=MISO_DETROIT

# Store It Cold (CoolBot)
SIT_EMAIL=
SIT_PASSWORD=

# SolArk inverter
SOLARK_USERNAME=
SOLARK_PASSWORD=
SOLARK_PLANT_ID=139155

# OpenEVSE charger (all optional)
OPENEVSE_URI=http://openevse.local
OPENEVSE_USER=
OPENEVSE_PASSWORD=
OPENEVSE_CLAIM_ID=20

# eGauge
EGAUGE_METER_NAME=
EGAUGE_USER=
EGAUGE_PASSWORD=

# Dashboard publisher: stores carbon estimates locally and can send readings to Drupal
DRUPAL_BASE_URL=
CF_DATA_TOKEN=
POWER_PUBLISH_INTERVAL=60
# Carbon tracking is enabled by default. Set to 0 to disable it.
PUBLISH_CARBON=1
CARBON_PUBLISH_MINUTES=5
# Combined power of all four ventilation fans. Replace the estimate with a measured value if available.
CARBON_FAN_POWER_W=124
# Truck charge % (Ford website) used only when the carbon model starts fresh
# (no carbon_live_state.json yet)
CARBON_START_EV_SOC_PERCENT=
